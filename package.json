{
	"name": "gh-calendar",
	"version": "0.1.1",
	"author": "Caetano G.",
	"description": "Display your GitHub contribution calendar as a colored grid in the terminal",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caetanoag/gh-calendar.git"
	},
	"homepage": "https://github.com/caetanoag/gh-calendar#readme",
	"bugs": {
		"url": "https://github.com/caetanoag/gh-calendar/issues"
	},
	"keywords": [
		"github",
		"contributions",
		"calendar",
		"graph",
		"cli",
		"terminal"
	],
	"type": "module",
	"bin": {
		"gh-calendar": "./dist/main.js"
	},
	"main": "./dist/main.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun build src/main.ts --outdir dist --target node --format esm",
		"dev": "bun run src/main.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"conf": "^16.0.0"
	}
}
